# SwipeX Integrated Environment Configuration (Milestone 1 & 2)
# Owner: Intern 5 (Platform, Testing & Deployment)

# System / Host Configuration
ENVIRONMENT=development
PORT_GATEWAY=8000
PORT_AUTH=8001
PORT_JOB_SERVICE=8002
PORT_RESUME_SERVICE=8003
PORT_FRONTEND=5173

# Database & Cache
POSTGRES_USER=swipex
POSTGRES_PASSWORD=swipex_dev_pass
POSTGRES_DB=swipex_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379

# JWT & RBAC Secrets
JWT_SECRET_KEY=swipex-milestone-dev-secret-key-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Microservice Inter-Service URLs
GATEWAY_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8000
JOB_SERVICE_URL=http://job_service:8000
RESUME_SERVICE_URL=http://resume_service:8000
